# Telegram
BOT_TOKEN=
ALLOWED_USER_IDS=

# Optional GigaChat credentials
GIGACHAT_CREDENTIALS=

# Check schedule
CHECK_INTERVAL_DAYS=7

# RuCaptcha residential proxy for kad.arbitr.ru.
# Recommended: HTTP port 2334 (works with both requests and Playwright).
# PROXY_URL=http://USERNAME:PASSWORD@ru.proxy.rucaptcha.com:2334
#
# SOCKS5 port 2333 works for requests, but Playwright 1.48/Chromium cannot
# authenticate to SOCKS5 proxies. Cookie refresh will fail with a clear error.
# PROXY_URL=socks5://USERNAME:PASSWORD@ru.proxy.rucaptcha.com:2333
#
# URL-encode special characters in USERNAME/PASSWORD (@ -> %40, : -> %3A).
# If PROXY_URL is unset or invalid, the bot logs an error and tries direct access.

# Optional path to a custom CA bundle (.pem) for verifying SSL to kad.arbitr.ru
# (e.g., Russian Trusted Root CA / proxy CA). If unset, SSL verification is
# disabled (verify=False) to avoid CERTIFICATE_VERIFY_FAILED through proxies.
# KAD_CA_BUNDLE=/app/certs/ca-bundle.pem
